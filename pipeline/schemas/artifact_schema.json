{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Museum as Code Artifact Sidecar",
  "description": "Canonical sidecar schema for museum-as-code artifacts after Phase B provenance normalization.",
  "type": "object",
  "required": [
    "id",
    "name",
    "designation",
    "designation_type",
    "era",
    "material",
    "location",
    "hgl_file",
    "license",
    "source_url",
    "credit",
    "confidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(nb|bt|kdh)_[0-9]{3}(_[0-9]+)?$" },
    "name": { "type": "string" },
    "name_en": { "type": "string" },
    "designation": { "type": "string" },
    "designation_ko": { "type": "string" },
    "designation_type": { "type": "string" },
    "category": { "type": "string" },
    "era": { "type": "string" },
    "material": { "type": "string" },
    "size": { "type": "string" },
    "location": { "type": "string" },
    "description": { "type": "string" },
    "description_en": { "type": "string" },
    "image_url": { "type": "string", "description": "Local docs-relative path only; remote URLs belong in source_url." },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "source_url", "license", "credit"],
        "properties": {
          "path": { "type": "string" },
          "source_url": { "type": "string" },
          "license": { "type": "string" },
          "credit": { "type": "string" },
          "needs_verification": { "type": "string" }
        }
      }
    },
    "source_url": { "type": "string" },
    "source_urls": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "credit": { "type": "string" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "needs_verification": { "type": "string" },
    "room_tags": { "type": "array", "items": { "type": "string" } },
    "hgl_file": { "type": "string" },
    "curator_copy_file": { "type": "string" },
    "source": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
