// 유물: 백제 금동대향로 (국보 제287호)
// 생성일: 2026-03-29

구조 유물_국보제287호 {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    분류: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    설명: 문자열,
    드라마연결: 문자열,
}

구현 유물_국보제287호 {
    함수 정보출력(자신: 유물_국보제287호) {
        출력(형식("=== {0} ({1}) ===", 자신.이름, 자신.지정번호))
        출력(형식("영문명: {0}", 자신.영문명))
        출력(형식("분류: {0}", 자신.분류))
        출력(형식("시대: {0}", 자신.시대))
        출력(형식("재질: {0}", 자신.재질))
        출력(형식("크기: {0}", 자신.크기))
        출력(형식("소장처: {0}", 자신.소장처))
        출력(형식("드라마 연결: {0}", 자신.드라마연결))
    }
}

함수 main() {
    변수 이름_val = "백제 금동대향로"
    변수 영문명_val = "Baekje Gilt-Bronze Incense Burner"
    변수 지정번호_val = "국보 제287호"
    변수 분류_val = "금속 공예"
    변수 시대_val = "백제시대 (7세기)"
    변수 재질_val = "금동"
    변수 크기_val = "높이 22.0cm"
    변수 소장처_val = "국립부여박물관"
    변수 설명_val = "백제시대의 금동대향로로, 정교한 장식과优美的 형태가 특징이다. 불교 의식에서 사용된 중요한 법구이며, 백제 금속 공예의最高傑作으로 꼽힌다."
    변수 드라마연결_val = "악귀 봉인 의식에 사용되는 향로; 연기가 피어오르면 결계가 형성된다"
    
    변수 유물 = 유물_국보제287호 {
        이름: 이름_val,
        영문명: 영문명_val,
        지정번호: 지정번호_val,
        분류: 분류_val,
        시대: 시대_val,
        재질: 재질_val,
        크기: 크기_val,
        소장처: 소장처_val,
        설명: 설명_val,
        드라마연결: 드라마연결_val,
    }
    유물.정보출력()
}

main()
