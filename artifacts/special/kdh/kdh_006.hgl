// 유물: 금관총 금관 (국보 제87호)
// 생성일: 2026-03-29

구조 유물_국보제87호 {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    분류: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    설명: 문자열,
    드라마연결: 문자열,
}

구현 유물_국보제87호 {
    함수 정보출력(자신: 유물_국보제87호) {
        출력("=== ${자신.이름} (${자신.지정번호}) ===")
        출력("영문명: ${자신.영문명}")
        출력("분류: ${자신.분류}")
        출력("시대: ${자신.시대}")
        출력("재질: ${자신.재질}")
        출력("크기: ${자신.크기}")
        출력("소장처: ${자신.소장처}")
        출력("설명: ${자신.설명}")
        출력("드라마 연결: ${자신.드라마연결}")
    }
}

함수 main() {
    변수 이름_val = "금관총 금관"
    변수 영문명_val = "Gold Crown from Geumgwan Tomb"
    변수 지정번호_val = "국보 제87호"
    변수 분류_val = "금관"
    변수 시대_val = "삼국시대 (신라)"
    변수 재질_val = "금"
    변수 크기_val = "높이 6.5cm, 너비 20.5cm"
    변수 소장처_val = "국립경주박물관"
    변수 설명_val = "신라 금관총에서 출토된 황금 왕관으로, 초자성 등 정교한 장식이 달려 있다. 신라 왕실의 권위를 상징하는 유물이다."
    변수 드라마연결_val = "악귀의 왕이 쓰고 있던 황금 왕관의 모티프; 이를 탈취하면 봉인이 풀린다"

    변수 유물 = 유물_국보제87호 {
        이름: 이름_val,
        영문명: 영문명_val,
        지정번호: 지정번호_val,
        분류: 분류_val,
        시대: 시대_val,
        재질: 재질_val,
        크기: 크기_val,
        소장처: 소장처_val,
        설명: 설명_val,
        드라마연결: 드라마연결_val,
    }
    유물.정보출력()
}

main()
