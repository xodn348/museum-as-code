// 백자 달항아리 — Phase C hero artifact
// The most radical gesture here is emptiness.
// Source metadata is tracked in artifacts/heroes/hero_moon_jar.json

구조 히어로유물_hero_moon_jar {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    제작연도: 문자열,
    의의: 문자열,
    이미지경로: 문자열,
    라이선스: 문자열,
    출처검증: 불,
}

함수 main() {
    변수 artifact = 히어로유물_hero_moon_jar {
        이름: "백자 달항아리",
        영문명: "White Porcelain Moon Jar",
        지정번호: "국보 제262호 공개 이미지 예시",
        시대: "조선, 17–18세기",
        재질: "백자",
        크기: "Object-specific dimensions vary; source object verification required",
        소장처: "국립중앙박물관 공개 이미지 예시",
        제작연도: "Joseon, 17th–18th century",
        의의: "순백의 둥근 형태와 미세한 비대칭이 조선 미감의 절제를 보여주는 달항아리입니다.",
        이미지경로: "images/heroes/hero_moon_jar/moon-jar-nt310.jpg",
        라이선스: "KOGL Type 1",
        출처검증: 참
    }

    출력(형식("{0} — {1}", artifact.이름, artifact.지정번호))
    출력(형식("({0})", artifact.영문명))
    출력(artifact.의의)
}

main()
