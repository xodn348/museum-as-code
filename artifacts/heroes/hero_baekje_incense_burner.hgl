함수 main() {
    변수 artifact = 히어로유물_hero_baekje_incense_burner {
        이름: "백제 금동대향로",
        영문명: "Great Gilt-bronze Incense Burner of Baekje",
        지정번호: "국보 제287호",
        시대: "백제, 6–7세기",
        재질: "금동",
        크기: "Height 61.8 cm; maximum diameter 19.0 cm",
        소장처: "국립부여박물관",
        제작연도: "Baekje, 6th–7th century",
        의의: "봉황, 산악형 뚜껑, 연꽃 몸체, 용 받침이 한 몸을 이룬 백제 공예의 절정입니다.",
        이야기: "1993년 부여 능산리 절터의 진흙 속에서 1,400년을 잠들었던 청동 향로 한 점이 발견되었을 때, 그것은 백제 멸망 이후 가장 충격적인 고고학 발견으로 기록되었습니다. 높이 64cm의 향로는 받침의 용, 몸체의 연꽃, 뚜껑의 박산 — 도교의 신선세계 — , 그리고 정상의 봉황까지 한국·중국·인도의 종교적 상상을 한 작품에 압축해 담았습니다. 뚜껑의 작은 구멍 다섯 개로 향연이 새어나오면 마치 산 위에서 안개가 피어나는 듯한 환영을 만들어, 향로 자체가 작은 세계를 짓는 장치로 설계되었음을 보여줍니다. 백제의 금속공예가 동아시아 어느 왕국에도 뒤지지 않았음을 단 한 점으로 증명하는, 국립부여박물관의 가장 무거운 한 점입니다.",
        이야기_영문: "When this bronze incense burner was lifted from the mud of a temple site in Buyeo in 1993, after 1,400 years underground, it was the most startling Korean archaeological find since the fall of Baekje itself. Sixty-four centimeters tall, the burner stacks a dragon at the base, lotus petals on the body, the Daoist Mount Bo on the lid, and a phoenix at the summit — a vertical compression of Korean, Chinese, and Indian religious imagination into a single object. Smoke escapes through five small openings in the lid in a way that, lit and breathed, makes mist appear to rise from a peak: the burner was engineered to construct a small cosmos in the air above it. Now the heaviest single object at the Buyeo National Museum, it is the proof — in one piece — that Baekje metalwork stood with the finest in 7th-century East Asia.",
        이미지경로: "images/heroes/hero_baekje_incense_burner/baekje-incense-burner.jpg",
        라이선스: "CC BY-SA 2.5",
        출처검증: 참
    }

    출력(형식("{0} — {1}", artifact.이름, artifact.지정번호))
    출력(형식("({0})", artifact.영문명))
    출력("")
    출력(artifact.이야기)
}

main()
