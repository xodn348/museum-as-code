// 금동미륵보살반가사유상 — Phase C hero artifact
// A single figure turns thought itself into sculpture.
// Source metadata is tracked in artifacts/heroes/hero_pensive_bodhisattva.json

구조 히어로유물_hero_pensive_bodhisattva {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    제작연도: 문자열,
    의의: 문자열,
    이미지경로: 문자열,
    라이선스: 문자열,
    출처검증: 불,
}

함수 main() {
    변수 artifact = 히어로유물_hero_pensive_bodhisattva {
        이름: "금동미륵보살반가사유상",
        영문명: "Pensive Bodhisattva",
        지정번호: "국보 제83호",
        시대: "삼국시대, 7세기 초",
        재질: "금동",
        크기: "Height 93.5 cm",
        소장처: "국립중앙박물관",
        제작연도: "Three Kingdoms Period, early 7th century",
        의의: "반가의 자세, 내려앉은 시선, 미소가 한국 불교조각의 상징이 된 금동 보살상입니다.",
        이미지경로: "images/heroes/hero_pensive_bodhisattva/meditating-maitreya.jpg",
        라이선스: "CC BY-SA 4.0",
        출처검증: 참
    }

    출력(형식("{0} — {1}", artifact.이름, artifact.지정번호))
    출력(형식("({0})", artifact.영문명))
    출력(artifact.의의)
}

main()
