// 합천 해인사 대장경판 — Phase C hero artifact
// A library carved so carefully it became architecture.
// Source metadata is tracked in artifacts/heroes/hero_tripitaka.json

구조 히어로유물_hero_tripitaka {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    제작연도: 문자열,
    의의: 문자열,
    이야기: 문자열,
    이야기_영문: 문자열,
    이미지경로: 문자열,
    라이선스: 문자열,
    출처검증: 불,
}

함수 main() {
    변수 artifact = 히어로유물_hero_tripitaka {
        이름: "합천 해인사 대장경판",
        영문명: "Printing Woodblocks of the Tripiṭaka Koreana",
        지정번호: "국보 제32호",
        시대: "고려, 1236–1251년",
        재질: "목판",
        크기: "81,258 woodblocks",
        소장처: "해인사",
        제작연도: "Goryeo, 1236–1251",
        의의: "고려가 새긴 8만여 장의 불교 경전 목판으로, 지식 보존의 거대한 시스템입니다.",
        이야기: "1232년 몽골 침입으로 초조대장경이 불에 탄 후, 고려 조정은 부처의 힘으로 침입을 막겠다는 서원으로 다시 한 번 대장경을 새겼고, 16년 만인 1251년에 81,258매의 목판이 완성되었습니다. 한 판에 각 면 22행 14자, 양면을 합치면 한 판이 약 644자 — 전체 5,200만 자가 단 한 글자의 오자도 없이 새겨져 있어, 인쇄술 이전 인류가 도달한 정밀도의 한 정점으로 평가됩니다. 13세기 중반 이래 합천 해인사 장경판전에 보관되어, 자연 통풍과 흙바닥, 숯과 소금의 단순한 조합만으로 750년간 곰팡이와 벌레로부터 살아남았습니다. 1995년 유네스코 세계문화유산으로 등재된, 책이 어떻게 천 년을 견딜 수 있는지를 보여주는 거대한 한 권의 도서관입니다.",
        이야기_영문: "After the original Tripitaka woodblocks burned in the Mongol invasion of 1232, the Goryeo court vowed that recarving the entire Buddhist canon would itself defend the kingdom — and sixteen years later, in 1251, 81,258 woodblocks were complete. Each face holds 22 lines of 14 characters; both faces together carry roughly 644 graphs per block, and across the full set more than 52 million characters appear without a single known transcription error — one of the high points of human precision in the age before printing. Since the mid-13th century the blocks have lived in the Janggyeong Panjeon storehouse at Haeinsa Temple, where natural ventilation, an earthen floor, and a simple bedding of charcoal and salt have kept them safe from mold and insects for 750 years. Inscribed on the UNESCO World Heritage list in 1995, the Tripitaka Koreana is a single book the size of a library — and a working demonstration that a book can survive a thousand years.",
        이미지경로: "images/heroes/hero_tripitaka/tripitaka-koreana-02.jpg",
        라이선스: "CC0",
        출처검증: 참
    }

    출력(형식("{0} — {1}", artifact.이름, artifact.지정번호))
    출력(형식("({0})", artifact.영문명))
    출력("")
    출력(artifact.이야기)
}

main()
