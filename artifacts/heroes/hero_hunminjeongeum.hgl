// 훈민정음 해례본 — Phase C hero artifact
// A writing system appears with its own source code.
// Source metadata is tracked in artifacts/heroes/hero_hunminjeongeum.json

구조 히어로유물_hero_hunminjeongeum {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    제작연도: 문자열,
    의의: 문자열,
    이야기: 문자열,
    이야기_영문: 문자열,
    이미지경로: 문자열,
    라이선스: 문자열,
    출처검증: 불,
}

함수 main() {
    변수 artifact = 히어로유물_hero_hunminjeongeum {
        이름: "훈민정음 해례본",
        영문명: "Hunminjeongeum Manuscript (Haerye Edition)",
        지정번호: "국보 제70호 / 유네스코 세계기록유산",
        시대: "조선, 1446년",
        재질: "종이 인쇄본",
        크기: "33 leaves (as described in heritage sources)",
        소장처: "간송미술관",
        제작연도: "Joseon, 1446",
        의의: "한글이 왜 만들어졌고 어떻게 작동하는지 설명하는 문자 창제의 원본 기록입니다.",
        이야기: "1443년 세종은 새 문자 28자를 창제했고, 1446년 집현전 학자들과 함께 그 문자가 어떻게, 왜, 어떤 음운 원리로 만들어졌는지를 한 권의 해설서에 담아냈습니다 — 이것이 『훈민정음』 해례본입니다. 자음은 발음 기관의 모양에서, 모음은 하늘·땅·사람의 세 요소에서 출발했다는 설계 원리가 본문에 그대로 적혀 있어, 인류 역사상 거의 유일하게 발명자와 발명 원리가 모두 기록된 문자 체계가 되었습니다. 임진왜란과 일제강점기를 거치며 거의 사라질 뻔한 이 책은 1940년 안동에서 발견되어, 간송 전형필이 당시 기와집 열 채 값을 치르고 사들여 보존했습니다. 현재 간송미술관에 소장되어 있고 1997년 유네스코 세계기록유산에 등재된, ‘한국어를 쓴다’는 행위의 헌법과도 같은 책입니다.",
        이야기_영문: "In 1443 King Sejong invented a writing system of 28 letters, and in 1446 he and the scholars of the Hall of Worthies published the manual that explained how, why, and on what phonetic logic those letters had been made — the Hunminjeongeum Haerye. The text records that the consonants were modeled on the shape of the speech organs and the vowels on the three cosmological elements of heaven, earth, and human, making this one of the very few writing systems in human history whose inventor and design principles are both documented at the source. Nearly lost through the Imjin War and the Japanese colonial period, the book reappeared in Andong in 1940 and was preserved by the collector Jeon Hyeong-pil — Kansong — who paid the price of ten tile-roofed houses to keep it in Korea. Now held at the Kansong Art Museum and inscribed on the UNESCO Memory of the World register in 1997, the Haerye is something close to the constitution of writing the Korean language.",
        이미지경로: "images/heroes/hero_hunminjeongeum/hunminjeongeum-haerye.jpg",
        라이선스: "Public domain",
        출처검증: 거짓
    }

    출력(형식("{0} — {1}", artifact.이름, artifact.지정번호))
    출력(형식("({0})", artifact.영문명))
    출력("")
    출력(artifact.이야기)
}

main()
