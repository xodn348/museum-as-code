// 유물: 칠지도 (국보 제369호)
// 생성일: 2026-03-29

구조 유물_국보제369호 {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    분류: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    설명: 문자열,
    드라마연결: 문자열,
}

구현 유물_국보제369호 {
    함수 정보출력(자신: 유물_국보제369호) {
        출력("=== ${자신.이름} (${자신.지정번호}) ===")
        출력("영문명: ${자신.영문명}")
        출력("분류: ${자신.분류}")
        출력("시대: ${자신.시대}")
        출력("재질: ${자신.재질}")
        출력("크기: ${자신.크기}")
        출력("소장처: ${자신.소장처}")
        출력("설명: ${자신.설명}")
        출력("드라마 연결: ${자신.드라마연결}")
    }
}

함수 main() {
    변수 이름_val = "칠지도"
    변수 영문명_val = "Seven-Branched Sword"
    변수 지정번호_val = "국보 제369호"
    변수 분류_val = "철기"
    변수 시대_val = "백제시대 (4세기)"
    변수 재질_val = "철"
    변수 크기_val = "길이 35.9cm"
    변수 소장처_val = "국립중앙박물관"
    변수 설명_val = "백제시대 특수 철기인 칠지도는 7개의 날카로운 가지가 달린 독특한 형태로, 악귀를 쫓는 신성한 무기로 전해진다."
    변수 드라마연결_val = "주인공의 비밀 무기인 칠지검의 실제 원형; 악귀를 베는 전설의 검"

    변수 유물 = 유물_국보제369호 {
        이름: 이름_val,
        영문명: 영문명_val,
        지정번호: 지정번호_val,
        분류: 분류_val,
        시대: 시대_val,
        재질: 재질_val,
        크기: 크기_val,
        소장처: 소장처_val,
        설명: 설명_val,
        드라마연결: 드라마연결_val,
    }
    유물.정보출력()
}

main()
