// 유물: 금동미륵보살반가사유상 (국보 제78호)
// 생성일: 2026-03-29

구조 유물_국보제78호 {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    분류: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    설명: 문자열,
    드라마연결: 문자열,
}

구현 유물_국보제78호 {
    함수 정보출력(자신: 유물_국보제78호) {
        출력(형식("=== {0} ({1}) ===", 자신.이름, 자신.지정번호))
        출력(형식("영문명: {0}", 자신.영문명))
        출력(형식("분류: {0}", 자신.분류))
        출력(형식("시대: {0}", 자신.시대))
        출력(형식("재질: {0}", 자신.재질))
        출력(형식("크기: {0}", 자신.크기))
        출력(형식("소장처: {0}", 자신.소장처))
        출력(형식("드라마 연결: {0}", 자신.드라마연결))
    }
}

함수 main() {
    변수 이름_val = "금동미륵보살반가사유상"
    변수 영문명_val = "Gilt-bronze Maitreya Bodhisattva in Pensive Posture"
    변수 지정번호_val = "국보 제78호"
    변수 분류_val = "불교 조각"
    변수 시대_val = "삼국시대 (6-7세기)"
    변수 재질_val = "금동"
    변수 크기_val = "높이 93.5cm"
    변수 소장처_val = "국립중앙박물관"
    변수 설명_val = "삼국시대 금동으로 제작된 미륵보살 반가사유상으로, 한 손을 턱에 괴고 사유의 자세로 앉아 있다. 고RIEUL 한국 불교 조각의 정수라 평가받는다."
    변수 드라마연결_val = "악귀를 쫓는 주인공이 과거 전투에서 이 보살상 앞에 무릎 꿇고 힘을 빌리는 장면의 배경이 된다"
    
    변수 유물 = 유물_국보제78호 {
        이름: 이름_val,
        영문명: 영문명_val,
        지정번호: 지정번호_val,
        분류: 분류_val,
        시대: 시대_val,
        재질: 재질_val,
        크기: 크기_val,
        소장처: 소장처_val,
        설명: 설명_val,
        드라마연결: 드라마연결_val,
    }
    유물.정보출력()
}

main()
