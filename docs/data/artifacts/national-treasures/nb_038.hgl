// 금속활자 - 국보 제15호 디지털 아카이브
// 자동 생성됨: museum-as-code 파이프라인
// 생성일: 2026-03-30

구조 유물_국보제15호 {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    분류: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    설명: 문자열,
    이미지URL: 문자열,
    API출처: 문자열,
}

구현 유물_국보제15호 {
    함수 정보출력(자신: 유물_국보제15호) {
        출력(형식("=== {0} ({1}) ===", 자신.이름, 자신.지정번호))
        출력(형식("영문명: {0}", 자신.영문명))
        출력(형식("분류: {0}", 자신.분류))
        출력(형식("시대: {0}", 자신.시대))
        출력(형식("재질: {0}", 자신.재질))
        출력(형식("크기: {0}", 자신.크기))
        출력(형식("소장처: {0}", 자신.소장처))
        출력(형식("설명: {0}", 자신.설명))
    }
}

함수 main() {
    변수 이름_val = "금속활자"
    변수 영문명_val = "Metal Movable Type"
    변수 지정번호_val = "국보 제15호"
    변수 분류_val = "전적류"
    변수 시대_val = "고려시대"
    변수 재질_val = "청동"
    변수 크기_val = "가로 7cm, 세로 10cm"
    변수 소장처_val = "한국국학진흥원"
    변수 설명_val = "고려 시대의 금속활자로, 세계 최고 수준의 인쇄 기술을 보여주는 유물이다."
    변수 이미지URL_val = "https://www.emuseum.go.kr/images/relic/11/0015.jpg"
    변수 API출처_val = "e뮤지엄 Open API (fallback)"
    변수 유물 = 유물_국보제15호 {
        이름: 이름_val,
        영문명: 영문명_val,
        지정번호: 지정번호_val,
        분류: 분류_val,
        시대: 시대_val,
        재질: 재질_val,
        크기: 크기_val,
        소장처: 소장처_val,
        설명: 설명_val,
        이미지URL: 이미지URL_val,
        API출처: API출처_val,
    }
    유물.정보출력()
}

main()
