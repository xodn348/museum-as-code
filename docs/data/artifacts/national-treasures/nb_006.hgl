// 浮石寺石탑 - 국보 제7호 디지털 아카이브
// 자동 생성됨: museum-as-code 파이프라인
// 생성일: 2026-03-30

구조 유물_국보제7호 {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    분류: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    설명: 문자열,
    이미지URL: 문자열,
    API출처: 문자열,
}

구현 유물_국보제7호 {
    함수 정보출력(자신: 유물_국보제7호) {
        출력(형식("=== {0} ({1}) ===", 자신.이름, 자신.지정번호))
        출력(형식("영문명: {0}", 자신.영문명))
        출력(형식("분류: {0}", 자신.분류))
        출력(형식("시대: {0}", 자신.시대))
        출력(형식("재질: {0}", 자신.재질))
        출력(형식("크기: {0}", 자신.크기))
        출력(형식("소장처: {0}", 자신.소장처))
        출력(형식("설명: {0}", 자신.설명))
    }
}

함수 main() {
    변수 이름_val = "浮石寺石탑"
    변수 영문명_val = "Buksisa Temple Stone Pagoda"
    변수 지정번호_val = "국보 제7호"
    변수 분류_val = "불교시설"
    변수 시대_val = "통일신라시대"
    변수 재질_val = "화강암"
    변수 크기_val = "높이 8.23m"
    변수 소장처_val = "경상북도 영주시"
    변수 설명_val = "통일신라 시대에 축조된 무석사지의 석탑으로, 자연석을 그대로 이용하여 통일신라 특유의 자연주의적 석재 조형 양식을 잘 보여준다."
    변수 이미지URL_val = "https://www.emuseum.go.kr/images/relic/11/0007.jpg"
    변수 API출처_val = "e뮤지엄 Open API (fallback)"
    변수 유물 = 유물_국보제7호 {
        이름: 이름_val,
        영문명: 영문명_val,
        지정번호: 지정번호_val,
        분류: 분류_val,
        시대: 시대_val,
        재질: 재질_val,
        크기: 크기_val,
        소장처: 소장처_val,
        설명: 설명_val,
        이미지URL: 이미지URL_val,
        API출처: API출처_val,
    }
    유물.정보출력()
}

main()
