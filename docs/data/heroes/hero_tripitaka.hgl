// 합천 해인사 대장경판 — Phase C hero artifact
// A library carved so carefully it became architecture.
// Source metadata is tracked in artifacts/heroes/hero_tripitaka.json

구조 히어로유물_hero_tripitaka {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    제작연도: 문자열,
    의의: 문자열,
    이미지경로: 문자열,
    라이선스: 문자열,
    출처검증: 불,
}

함수 main() {
    변수 artifact = 히어로유물_hero_tripitaka {
        이름: "합천 해인사 대장경판",
        영문명: "Printing Woodblocks of the Tripiṭaka Koreana",
        지정번호: "국보 제32호",
        시대: "고려, 1236–1251년",
        재질: "목판",
        크기: "81,258 woodblocks",
        소장처: "해인사",
        제작연도: "Goryeo, 1236–1251",
        의의: "고려가 새긴 8만여 장의 불교 경전 목판으로, 지식 보존의 거대한 시스템입니다.",
        이미지경로: "images/heroes/hero_tripitaka/tripitaka-koreana-02.jpg",
        라이선스: "CC0",
        출처검증: 참
    }

    출력(형식("{0} — {1}", artifact.이름, artifact.지정번호))
    출력(형식("({0})", artifact.영문명))
    출력(artifact.의의)
}

main()
