    변수 크기 = "81,258 woodblocks"
    변수 소장처 = "해인사"
    변수 제작연도 = "Goryeo, 1236–1251"
    변수 의의 = "고려가 새긴 8만여 장의 불교 경전 목판으로, 지식 보존의 거대한 시스템입니다."
    변수 이미지경로 = "images/heroes/hero_tripitaka/tripitaka-koreana-woodblock.jpg"
    변수 라이선스 = "CC BY-SA 3.0"

    출력(형식("{0} — {1}", 이름, 지정번호))
