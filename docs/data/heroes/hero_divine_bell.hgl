// 성덕대왕신종 — Phase C hero artifact
// A sculpture you are meant to hear.
// Source metadata is tracked in artifacts/heroes/hero_divine_bell.json

구조 히어로유물_hero_divine_bell {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    제작연도: 문자열,
    의의: 문자열,
    이미지경로: 문자열,
    라이선스: 문자열,
    출처검증: 불,
}

함수 main() {
    변수 artifact = 히어로유물_hero_divine_bell {
        이름: "성덕대왕신종",
        영문명: "Divine Bell of King Seongdeok",
        지정번호: "국보 제29호",
        시대: "통일신라, 771년",
        재질: "청동",
        크기: "Height 365.0 cm; diameter 223.0 cm; weight 18.9 t",
        소장처: "국립경주박물관",
        제작연도: "Unified Silla, 771",
        의의: "부조와 명문, 울림으로 한국 범종의 기준이 된 통일신라의 거대한 청동 종입니다.",
        이미지경로: "images/heroes/hero_divine_bell/divine-bell-seongdeok.jpg",
        라이선스: "CC0",
        출처검증: 참
    }

    출력(형식("{0} — {1}", artifact.이름, artifact.지정번호))
    출력(형식("({0})", artifact.영문명))
    출력(artifact.의의)
}

main()
