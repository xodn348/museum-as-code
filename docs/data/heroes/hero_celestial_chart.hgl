// 천상열차분야지도 각석 — Phase C hero artifact
// The new dynasty wrote its sky in stone.
// Source metadata is tracked in artifacts/heroes/hero_celestial_chart.json

구조 히어로유물_hero_celestial_chart {
    이름: 문자열,
    영문명: 문자열,
    지정번호: 문자열,
    시대: 문자열,
    재질: 문자열,
    크기: 문자열,
    소장처: 문자열,
    제작연도: 문자열,
    의의: 문자열,
    이야기: 문자열,
    이야기_영문: 문자열,
    이미지경로: 문자열,
    라이선스: 문자열,
    출처검증: 불,
}

함수 main() {
    변수 artifact = 히어로유물_hero_celestial_chart {
        이름: "천상열차분야지도 각석",
        영문명: "Stone Constellation Chart (Cheonsang Yeolcha Bunyajido)",
        지정번호: "국보 제228호",
        시대: "조선, 1395년",
        재질: "석각",
        크기: "About 211.0 × 123.0 cm (catalogue source)",
        소장처: "국립고궁박물관",
        제작연도: "Joseon, 1395",
        의의: "별자리와 계절, 왕조의 정당성을 검은 돌 위에 새긴 조선의 천문도입니다.",
        이야기: "1395년 태조 이성계는 새 왕조의 정당성을 하늘의 질서에 묶어 두기 위해, 고구려 시대의 옛 천문도 탁본을 바탕으로 별 1,467개를 검은 돌 위에 새긴 천문도를 만들었습니다. 비석 한복판의 둥근 별자리도는 적도와 황도, 28수(宿)의 위치까지 정확히 새겨져 있어, 14세기 동아시아 천문학의 가장 정밀한 결과물 중 하나로 평가됩니다. 비석 위쪽에는 별자리도의 작성 원리와 28수의 거리, 별 등급이 함께 새겨져 — 이 돌 한 장이 곧 한 권의 천문서 역할을 합니다. 현재 국립고궁박물관에 보관되어 있고 만 원권 지폐 뒷면 도안의 출처이기도 한, 조선이 하늘을 어떻게 그렸는지를 한 점에 압축한 비석입니다.",
        이야기_영문: "In 1395 Yi Seong-gye, founding king of Joseon, ordered a celestial chart cut into black stone — 1,467 stars laid out from a Goguryeo-era rubbing whose original survives only as legend — to anchor his new dynasty's legitimacy to the order of the sky. At the center of the stone, a circular star map records the celestial equator and ecliptic and the positions of the 28 lunar lodges with enough accuracy to count among the most precise astronomical artifacts of 14th-century East Asia. The stone also carries the principles by which the chart was drawn, the distances between the 28 lodges, and the magnitudes of the stars — a single slab of granite functioning as a complete astronomical treatise. Now at the National Palace Museum of Korea and famously the source of the design printed on the back of the 10,000-won banknote, the chart is Joseon's compressed answer to a simple question: how do you draw the sky?",
        이미지경로: "images/heroes/hero_celestial_chart/cheonsang-chart.jpg",
        라이선스: "KOGL Type 1",
        출처검증: 참
    }

    출력(형식("{0} — {1}", artifact.이름, artifact.지정번호))
    출력(형식("({0})", artifact.영문명))
    출력("")
    출력(artifact.이야기)
}

main()
